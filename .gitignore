# --- Top-level ignores ---

# Go
wrapper/bin/
wrapper/*.test
wrapper/*.out
wrapper/coverage.out

# Embedded UI bundle — regenerated by `make ui-build`. Required at
# compile time (the //go:embed directive in uiserver.go fails the
# build if dist/index.html is missing).
wrapper/internal/uiserver/dist/

# Bun / Node
**/node_modules/
**/dist/
**/.cache/
**/*.tsbuildinfo

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
.nfs*
**/.nfs*

# Convex local state
db/.convex
db/convex-local-backend.log
db/docker/state/
db/convex-spec.yaml

# Env files
**/.env
**/.env.local
**/.env.*.local

# DFTStream scratch / generated outputs
/example_logs/
/tmp-orca/
*.gbw
*.densities
*.densitiesinfo

.examples
scripts/stage-examples-for-import.sh
scripts/release-local.sh
.env.*
!.env.example
# Claude Code local state (agent worktrees, settings)
.claude/

# Internal planning notes and retired files, kept locally only
.old/
